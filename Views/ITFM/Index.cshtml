@model IEnumerable<RefineryBooking.Models.Booking>
@{
    ViewData["Title"] = "IT & Facilities Readiness Queue";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0" style="color: var(--refinery-navy);">
            <i class="fa-solid fa-headset text-info me-2"></i> IT & Facilities Readiness Queue
        </h2>
        <p class="text-muted mb-0">Click any booking card to view full details and update setup status.</p>
    </div>
    <span class="badge bg-info text-white fs-6 px-3 py-2">
        <i class="fa-solid fa-toolbox me-1"></i> @Model.Count() Pending Setups
    </span>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card card-industrial text-center py-5">
        <div class="card-body">
            <i class="fa-solid fa-check-double fa-3x text-success mb-3"></i>
            <h5 class="fw-bold text-muted">All Equipment Ready!</h5>
            <p class="text-muted">No upcoming approved meetings currently require AV/IT setup.</p>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var item in Model)
        {
            var req = item.ITRequirement;
            var statusColor = req?.SetupStatus == RefineryBooking.Models.TechSetupStatus.Ready ? "success"
                            : req?.SetupStatus == RefineryBooking.Models.TechSetupStatus.IssueReported ? "danger"
                            : "warning";
            var statusIcon = req?.SetupStatus == RefineryBooking.Models.TechSetupStatus.Ready ? "fa-check-circle"
                           : req?.SetupStatus == RefineryBooking.Models.TechSetupStatus.IssueReported ? "fa-triangle-exclamation"
                           : "fa-hourglass-half";
            var statusText = req?.SetupStatus == RefineryBooking.Models.TechSetupStatus.Ready ? "Setup Ready"
                           : req?.SetupStatus == RefineryBooking.Models.TechSetupStatus.IssueReported ? "Issue Reported"
                           : "Setup Pending";

            if (req == null && item.RequiresITFMHelp)
            {
                statusColor = "info";
                statusIcon = "fa-hand-sparkles";
                statusText = "Help Requested";
            }

            <div class="card card-industrial shadow-sm border-start border-info border-4">

                <!-- COMPACT HEADER -->
                <div class="card-header bg-white py-3 d-flex align-items-center gap-3"
                     style="cursor:pointer;" onclick="toggleCard(@item.Id)">
                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                        <span class="badge bg-dark px-3 py-2 font-monospace">BKG-@item.Id</span>
                        <span class="badge bg-@statusColor @(statusColor == "warning" ? "text-dark" : "")">
                            <i class="fa-solid @statusIcon me-1"></i> @statusText
                        </span>
                    </div>
                    <div class="flex-grow-1 ms-2">
                        <strong class="text-dark">@item.MeetingTitle</strong>
                        <span class="text-muted small ms-2">— @item.Department</span>
                    </div>
                    <div class="d-flex align-items-center gap-3 flex-shrink-0">
                        <span class="small text-muted">
                            <i class="fa-solid fa-door-closed me-1"></i>@item.ConferenceRoom?.Name
                        </span>
                        <span class="small text-muted">
                            <i class="fa-solid fa-clock me-1"></i>@item.StartTime.ToString("MMM dd, HH:mm") – @item.EndTime.ToString("HH:mm")
                        </span>
                        <i class="fa-solid fa-chevron-down text-muted toggle-icon-itfm-@item.Id" style="transition:transform 0.2s;"></i>
                    </div>
                </div>

                <!-- EXPANDED DETAILS -->
                <div id="itfm-details-@item.Id" class="collapse">
                    <div class="card-body p-4">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <h6 class="fw-bold text-uppercase small text-muted mb-3">
                                    <i class="fa-solid fa-circle-info me-1"></i> Meeting Details
                                </h6>
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td class="fw-semibold text-muted" style="width:40%">Booking ID</td>
                                        <td><span class="font-monospace fw-bold">BKG-@item.Id</span></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-semibold text-muted">Meeting</td>
                                        <td><strong>@item.MeetingTitle</strong></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-semibold text-muted">Organizer</td>
                                        <td>@item.OrganizerName</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-semibold text-muted">Department</td>
                                        <td>@item.Department</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-semibold text-muted">Hall</td>
                                        <td>
                                            <span class="badge bg-secondary">@item.ConferenceRoom?.Name</span>
                                            <small class="text-muted d-block">@item.ConferenceRoom?.BuildingLocation</small>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-semibold text-muted">Date & Time</td>
                                        <td>
                                            <strong>@item.StartTime.ToString("dddd, dd MMM yyyy")</strong><br />
                                            <span class="text-muted">@item.StartTime.ToString("HH:mm") – @item.EndTime.ToString("HH:mm")</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-semibold text-muted">Participants</td>
                                        <td><i class="fa-solid fa-users me-1 text-muted"></i> @item.ExpectedAttendees people</td>
                                    </tr>
                                </table>
                            </div>

                            <div class="col-md-6">
                                <h6 class="fw-bold text-uppercase small text-muted mb-3">
                                    <i class="fa-solid fa-plug me-1"></i> Equipment Required
                                </h6>
                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    @if (item.RequiresCatering == true) { <span class="badge bg-warning text-dark"><i class="fa-solid fa-mug-hot me-1"></i> Refreshments</span> }
                                    @if (req?.NeedsVideoConferencing == true) { <span class="badge bg-info text-white"><i class="fa-solid fa-video me-1"></i> Video Conf</span> }
                                    @if (req?.NeedsProjector == true) { <span class="badge bg-primary"><i class="fa-solid fa-projector me-1"></i> Projector</span> }
                                    @if (req?.NeedsWhiteboard == true) { <span class="badge bg-success"><i class="fa-solid fa-chalkboard me-1"></i> Whiteboard</span> }
                                    @if (req?.NeedsPASystem == true) { <span class="badge bg-danger"><i class="fa-solid fa-tower-broadcast me-1"></i> PA System</span> }
                                    @if (req?.NeedsLaptop == true) { <span class="badge bg-secondary"><i class="fa-solid fa-laptop me-1"></i> Laptop</span> }
                                    @if (req?.NeedsLaserPointer == true) { <span class="badge bg-dark"><i class="fa-solid fa-computer-mouse me-1"></i> Laser Pointer</span> }
                                    @if (req?.MicCount > 0) { <span class="badge bg-dark"><i class="fa-solid fa-microphone me-1"></i> @req.MicCount Mics</span> }
                                    @if (req == null && item.RequiresITFMHelp) { <span class="badge bg-light text-dark border"><i class="fa-solid fa-person-circle-question me-1"></i> General Help Requested</span> }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(req?.TechNotes))
                                {
                                    <div class="alert alert-info py-2 small mb-3">
                                        <i class="fa-solid fa-note-sticky me-1"></i> <em>@req.TechNotes</em>
                                    </div>
                                }

                                @if (req != null)
                                {
                                    <hr />
                                    <h6 class="fw-bold text-uppercase small text-muted mb-2">Update Setup Status</h6>
                                    <div class="btn-group shadow-sm" role="group">
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@req.Id" />
                                            <input type="hidden" name="status" value="@RefineryBooking.Models.TechSetupStatus.Ready" />
                                            <button type="submit" class="btn btn-success fw-bold">
                                                <i class="fa-solid fa-check me-1"></i> Mark Ready
                                            </button>
                                        </form>
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@req.Id" />
                                            <input type="hidden" name="status" value="@RefineryBooking.Models.TechSetupStatus.Pending" />
                                            <button type="submit" class="btn btn-outline-warning text-dark fw-bold">
                                                <i class="fa-solid fa-rotate-left me-1"></i> Reset
                                            </button>
                                        </form>
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@req.Id" />
                                            <input type="hidden" name="status" value="@RefineryBooking.Models.TechSetupStatus.IssueReported" />
                                            <button type="submit" class="btn btn-outline-danger fw-bold">
                                                <i class="fa-solid fa-triangle-exclamation me-1"></i> Report Issue
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        function toggleCard(id) {
            var details = document.getElementById('itfm-details-' + id);
            var icon = document.querySelector('.toggle-icon-itfm-' + id);
            var bsCollapse = bootstrap.Collapse.getOrCreateInstance(details);
            bsCollapse.toggle();
            icon.style.transform = details.classList.contains('show') ? 'rotate(0deg)' : 'rotate(180deg)';
        }

        document.addEventListener('DOMContentLoaded', function () {
            var cards = document.querySelectorAll('[id^="itfm-details-"]');
            if (cards.length === 1) {
                var id = cards[0].id.replace('itfm-details-', '');
                toggleCard(id);
            }
        });
    </script>
}