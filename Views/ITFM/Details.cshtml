@model RefineryBooking.Models.Booking
@{
    ViewData["Title"] = $"IT/AV Requirements — BKG-{Model.Id}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:var(--nrl-navy);">
            <i class="fa-solid fa-toolbox me-2"></i>IT & AV Preparation — <span class="font-monospace">BKG-@Model.Id</span>
        </h4>
        <p class="text-muted small mb-0">Equipment requirements and technician setup status.</p>
    </div>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>Back to Queue
    </a>
</div>

<div class="row g-4">
    <!-- Meeting overview -->
    <div class="col-md-6">
        <div class="card card-industrial">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0" style="color:var(--nrl-navy);">
                    <i class="fa-solid fa-info-circle me-2"></i>Meeting Summary
                </h6>
            </div>
            <div class="card-body p-4">
                <table class="table table-borderless table-sm">
                    <tr><td class="fw-semibold text-muted" style="width:38%;">Booking Ref</td><td><span class="badge bg-dark font-monospace">BKG-@Model.Id</span></td></tr>
                    <tr><td class="fw-semibold text-muted">Meeting Title</td><td><strong>@Model.MeetingTitle</strong></td></tr>
                    <tr><td class="fw-semibold text-muted">Organizer</td><td>@Model.OrganizerName</td></tr>
                    <tr><td class="fw-semibold text-muted">Department</td><td>@Model.Department</td></tr>
                    <tr>
                        <td class="fw-semibold text-muted">Conference Hall</td>
                        <td>
                            <strong>@Model.ConferenceRoom?.Name</strong>
                            <small class="text-muted d-block">@Model.ConferenceRoom?.BuildingLocation</small>
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-semibold text-muted">Date & Time</td>
                        <td>
                            <strong>@Model.StartTime.ToString("dddd, dd MMM yyyy")</strong><br />
                            <span class="text-muted">@Model.StartTime.ToString("HH:mm") – @Model.EndTime.ToString("HH:mm")</span>
                        </td>
                    </tr>
                    <tr><td class="fw-semibold text-muted">Expected Attendees</td><td>@Model.ExpectedAttendees people</td></tr>
                </table>
            </div>
        </div>
    </div>

    <!-- Equipment Checklist & Tech Notes -->
    <div class="col-md-6">
        <div class="card card-industrial mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0" style="color:var(--nrl-navy);">
                    <i class="fa-solid fa-plug me-2"></i>Equipment & AV Checklist
                </h6>
            </div>
            <div class="card-body p-4">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @if (Model.RequiresCatering) { <span class="badge bg-warning text-dark px-3 py-2"><i class="fa-solid fa-mug-hot me-1"></i>Refreshments</span> }
                    @if (Model.ITRequirement?.NeedsVideoConferencing == true) { <span class="badge bg-info text-white px-3 py-2"><i class="fa-solid fa-video me-1"></i>Video Conf</span> }
                    @if (Model.ITRequirement?.NeedsProjector == true) { <span class="badge bg-primary px-3 py-2"><i class="fa-solid fa-projector me-1"></i>Projector</span> }
                    @if (Model.ITRequirement?.NeedsWhiteboard == true) { <span class="badge bg-success px-3 py-2"><i class="fa-solid fa-chalkboard me-1"></i>Whiteboard</span> }
                    @if (Model.ITRequirement?.NeedsPASystem == true) { <span class="badge bg-danger px-3 py-2"><i class="fa-solid fa-tower-broadcast me-1"></i>PA System</span> }
                    @if (Model.ITRequirement?.NeedsLaptop == true) { <span class="badge bg-secondary px-3 py-2"><i class="fa-solid fa-laptop me-1"></i>Laptop</span> }
                    @if (Model.ITRequirement?.NeedsLaserPointer == true) { <span class="badge bg-dark px-3 py-2"><i class="fa-solid fa-computer-mouse me-1"></i>Laser Pointer</span> }
                    @if (Model.ITRequirement?.MicCount > 0) { <span class="badge bg-dark px-3 py-2"><i class="fa-solid fa-microphone me-1"></i>@Model.ITRequirement.MicCount Microphones</span> }
                </div>

                @if (Model.RequiresITFMHelp && !string.IsNullOrWhiteSpace(Model.ITFMHelpDetails))
                {
                    <div class="alert alert-info py-2 small mb-3">
                        <strong class="d-block"><i class="fa-solid fa-comment-dots me-1"></i>User Note to ITFM:</strong>
                        <em>@Model.ITFMHelpDetails</em>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ITRequirement?.TechNotes))
                {
                    <div class="alert alert-secondary py-2 small mb-3">
                        <strong class="d-block"><i class="fa-solid fa-sticky-note me-1"></i>Current Tech Note:</strong>
                        @Model.ITRequirement.TechNotes
                    </div>
                }

                <form asp-action="AddNote" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="itReqId" value="@(Model.ITRequirement?.Id ?? 0)" />
                    <label class="form-label fw-bold small">Add / Update Tech Note</label>
                    <div class="input-group">
                        <input type="text" name="note" class="form-control form-control-sm"
                               placeholder="e.g. Projector tested, HDMI cable placed on podium"
                               value="@(Model.ITRequirement?.TechNotes)" required />
                        <button type="submit" class="btn btn-sm btn-nrl-primary">Save Note</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
