@model IEnumerable<RefineryBooking.Models.HallBlock>
@{
    ViewData["Title"] = "Hall Availability & Blocking";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:var(--nrl-navy);">
            <i class="fa-solid fa-ban me-2"></i>Hall Blocking & Maintenance
        </h4>
        <p class="text-muted small mb-0">Block conference halls for safety briefings, maintenance, or plant shutdowns.</p>
    </div>
    <a asp-action="Create" class="btn btn-nrl-primary">
        <i class="fa-solid fa-lock me-1"></i>Block a Hall
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
        <i class="fa-solid fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card card-industrial">
    <div class="card-header bg-white py-3">
        <h6 class="fw-bold mb-0" style="color:var(--nrl-navy);">
            <i class="fa-solid fa-calendar-xmark me-2"></i>Active Hall Blocks
        </h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Blocked Hall</th>
                        <th>Location</th>
                        <th>Blocked Date</th>
                        <th>Reason</th>
                        <th>Notes / Details</th>
                        <th>Blocked By</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="fa-solid fa-circle-check text-success fa-2x mb-2 d-block"></i>
                                No active hall blocks. All conference rooms are available for booking.
                            </td>
                        </tr>
                    }
                    @foreach (var b in Model)
                    {
                        var reasonBadge = b.Reason switch {
                            RefineryBooking.Models.HallBlockReason.Safety => "bg-danger",
                            RefineryBooking.Models.HallBlockReason.Maintenance => "bg-warning text-dark",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td class="fw-bold">@b.ConferenceRoom?.Name</td>
                            <td><small class="text-muted">@b.ConferenceRoom?.BuildingLocation</small></td>
                            <td><span class="badge bg-dark font-monospace">@b.BlockedDate.ToString("dd MMM yyyy")</span></td>
                            <td><span class="badge @reasonBadge">@b.Reason</span></td>
                            <td><em>@(string.IsNullOrWhiteSpace(b.Notes) ? "—" : b.Notes)</em></td>
                            <td><small class="text-muted">@(b.CreatedBy?.FullName ?? "Admin")</small></td>
                            <td class="text-end">
                                <form asp-action="Remove" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@b.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Remove block for @b.ConferenceRoom?.Name on @b.BlockedDate.ToString("dd MMM yyyy")?')">
                                        <i class="fa-solid fa-lock-open me-1"></i>Unblock
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
