@model IEnumerable<RefineryBooking.Models.Booking>
@{
    ViewData["Title"] = "Allocator Desk";
    var activeTab = ViewBag.ActiveTab as string ?? "review";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0" style="color:var(--nrl-navy);">
            <i class="fa-solid fa-clipboard-check me-2"></i>Allocator Desk
        </h4>
        <p class="text-muted small mb-0">Manage and action conference room booking requests.</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Export" asp-route-tab="@activeTab" class="btn btn-sm btn-outline-secondary">
                <i class="fa-solid fa-file-excel me-1"></i>Export to Excel
            </a>
        }
    </div>
</div>

@if (ViewBag.NoHallsAssigned == true)
{
    <div class="alert alert-warning d-flex gap-3 align-items-start mb-4" style="border-left:4px solid #e6a817;">
        <i class="fa-solid fa-triangle-exclamation fa-lg mt-1 text-warning"></i>
        <div>
            <strong>No halls assigned to you yet.</strong><br />
            <span class="small text-muted">
                You have not been assigned to any conference halls. Please contact an <strong>Admin</strong>
                to assign you to the halls you are responsible for.<br />
                <em>Admin Panel → Users → (your name) → <i class="fa-solid fa-building-lock"></i> Halls</em>
            </span>
        </div>
    </div>
}

<!-- TABS -->
<ul class="nav nav-tabs border-bottom mb-4" style="border-color:var(--nrl-border)!important;">
    <li class="nav-item">
        <a class="nav-link @(activeTab=="review"?"active fw-bold":"")"
           asp-action="Index" asp-route-tab="review" style="font-size:0.85rem;">
            <i class="fa-solid fa-inbox me-1"></i>For Review
            @if ((int)ViewBag.CountReview > 0)
            {
                <span class="badge ms-1" style="background:var(--nrl-navy);color:#fff;">@ViewBag.CountReview</span>
            }
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(activeTab=="pending"?"active fw-bold":"")"
           asp-action="Index" asp-route-tab="pending" style="font-size:0.85rem;">
            Pending <span class="badge bg-secondary ms-1">@ViewBag.CountPending</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(activeTab=="approved"?"active fw-bold":"")"
           asp-action="Index" asp-route-tab="approved" style="font-size:0.85rem;">
            Approved <span class="badge bg-success ms-1">@ViewBag.CountApproved</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(activeTab=="rejected"?"active fw-bold":"")"
           asp-action="Index" asp-route-tab="rejected" style="font-size:0.85rem;">
            Rejected <span class="badge bg-danger ms-1">@ViewBag.CountRejected</span>
        </a>
    </li>
    @if (User.IsInRole("Admin"))
    {
        <li class="nav-item">
            <a class="nav-link @(activeTab=="all"?"active fw-bold":"")"
               asp-action="Index" asp-route-tab="all" style="font-size:0.85rem;">All Bookings</a>
        </li>
    }
</ul>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
        <i class="fa-solid fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card card-industrial text-center py-5">
        <div class="card-body">
            <i class="fa-solid fa-check-double fa-2x mb-3 text-muted"></i>
            <p class="text-muted mb-0">No bookings in this category.</p>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-2">
        @foreach (var item in Model)
        {
            var borderCol = item.Status == RefineryBooking.Models.BookingStatus.Approved ? "border-success"
                          : item.Status == RefineryBooking.Models.BookingStatus.Rejected  ? "border-danger"
                          : item.Status == RefineryBooking.Models.BookingStatus.Cancelled ? "border-secondary"
                          : "border-primary";

            var statusLabel = item.Status switch {
                RefineryBooking.Models.BookingStatus.Approved               => "Approved",
                RefineryBooking.Models.BookingStatus.Rejected               => "Rejected",
                RefineryBooking.Models.BookingStatus.Cancelled              => "Cancelled",
                RefineryBooking.Models.BookingStatus.PendingAllocatorReview => "Awaiting Review",
                _ => "Pending"
            };
            var statusBg = item.Status switch {
                RefineryBooking.Models.BookingStatus.Approved               => "bg-success",
                RefineryBooking.Models.BookingStatus.Rejected               => "bg-danger",
                RefineryBooking.Models.BookingStatus.Cancelled              => "bg-secondary",
                RefineryBooking.Models.BookingStatus.PendingAllocatorReview => "bg-primary",
                _ => "bg-warning text-dark"
            };

            <div class="card card-industrial shadow-sm border-start border-4 @borderCol">
                <div class="card-header bg-white py-2 d-flex align-items-center gap-3 bkg-card-header"
                     onclick="toggleAllocCard(@item.Id)">
                    <span class="badge bg-dark font-monospace px-2 py-1">BKG-@item.Id</span>
                    <span class="badge @statusBg px-2 py-1 small">@statusLabel</span>
                    <div class="flex-grow-1 small">
                        <strong>@item.MeetingTitle</strong>
                        <span class="text-muted ms-2">@item.Department</span>
                        @if (item.RequiresAllocatorHelp)
                        {
                            <span class="badge ms-2" style="background:#cce5ff;color:#003d7a;border:1px solid #99caff;">
                                <i class="fa-solid fa-circle-question me-1"></i>Allocator Help Requested
                            </span>
                        }
                        @if (item.RequiresITFMHelp)
                        {
                            <span class="badge ms-1" style="background:#d4edda;color:#155724;border:1px solid #b8dacc;">
                                <i class="fa-solid fa-toolbox me-1"></i>ITFM Help Requested
                            </span>
                        }
                    </div>
                    <div class="d-flex gap-3 align-items-center flex-shrink-0 text-muted small">
                        <span><i class="fa-solid fa-door-closed me-1"></i>@item.ConferenceRoom?.Name</span>
                        <span><i class="fa-solid fa-clock me-1"></i>@item.StartTime.ToString("dd MMM, HH:mm")–@item.EndTime.ToString("HH:mm")</span>
                        <a asp-action="Details" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-primary" style="font-size:0.75rem;border-radius:2px;"
                           onclick="event.stopPropagation()">
                            <i class="fa-solid fa-eye me-1"></i>Details
                        </a>
                        <i class="fa-solid fa-chevron-down toggle-alloc-icon-@item.Id" style="transition:transform 0.2s;"></i>
                    </div>
                </div>

                <div id="alloc-details-@item.Id" class="collapse">
                    <div class="card-body pt-3 pb-3 px-4">
                        <div class="row g-3 small">
                            <div class="col-md-3"><span class="text-muted">Organizer:</span> <strong>@item.OrganizerName</strong></div>
                            <div class="col-md-3"><span class="text-muted">Cost Centre:</span> @item.CostCentre</div>
                            <div class="col-md-3"><span class="text-muted">Participants:</span> @item.ExpectedAttendees</div>
                            <div class="col-md-3"><span class="text-muted">Submitted:</span> @item.CreatedAt.ToLocalTime().ToString("dd MMM, HH:mm")</div>
                            @if (!string.IsNullOrWhiteSpace(item.Remarks))
                            {
                                <div class="col-12"><span class="text-muted">Remarks:</span> <em>@item.Remarks</em></div>
                            }
                            @if (item.RequiresAllocatorHelp && !string.IsNullOrWhiteSpace(item.AllocatorHelpDetails))
                            {
                                <div class="col-12">
                                    <div class="alert alert-primary py-2 mb-0 small">
                                        <i class="fa-solid fa-circle-question me-1"></i>
                                        <strong>Allocator Help:</strong> @item.AllocatorHelpDetails
                                    </div>
                                </div>
                            }
                        </div>

                        @if (activeTab == "review" || activeTab == "pending")
                        {
                            <div class="mt-3 d-flex gap-2">
                                <form asp-action="Approve" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-success fw-bold">
                                        <i class="fa-solid fa-check me-1"></i>Approve
                                    </button>
                                </form>
                                <button type="button" class="btn btn-sm btn-outline-danger fw-bold"
                                        data-bs-toggle="modal" data-bs-target="#rejectModal-@item.Id">
                                    <i class="fa-solid fa-xmark me-1"></i>Reject
                                </button>
                                @if (User.IsInRole("Admin"))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary fw-bold"
                                            data-bs-toggle="modal" data-bs-target="#cancelModal-@item.Id">
                                        <i class="fa-solid fa-ban me-1"></i>Cancel
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Reject Modal -->
            <div class="modal fade" id="rejectModal-@item.Id" tabindex="-1">
                <div class="modal-dialog modal-sm">
                    <form asp-action="Reject" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <div class="modal-content">
                            <div class="modal-header py-2" style="background:var(--nrl-navy);">
                                <h6 class="modal-title text-white">Reject BKG-@item.Id</h6>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <label class="form-label fw-bold small">Rejection Reason *</label>
                                <textarea name="reason" class="form-control form-control-sm" rows="3"
                                          placeholder="State reason for rejection..." required></textarea>
                            </div>
                            <div class="modal-footer py-2">
                                <button class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-sm btn-danger fw-bold">Confirm Reject</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Cancel Modal (Admin only) -->
            @if (User.IsInRole("Admin"))
            {
                <div class="modal fade" id="cancelModal-@item.Id" tabindex="-1">
                    <div class="modal-dialog modal-sm">
                        <form asp-action="Cancel" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <div class="modal-content">
                                <div class="modal-header py-2 bg-secondary text-white">
                                    <h6 class="modal-title">Cancel BKG-@item.Id</h6>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <textarea name="reason" class="form-control form-control-sm" rows="2"
                                              placeholder="Reason for cancellation..." required></textarea>
                                </div>
                                <div class="modal-footer py-2">
                                    <button class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Back</button>
                                    <button type="submit" class="btn btn-sm btn-dark fw-bold">Confirm Cancel</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
}

@section Scripts {
    <script>
        function toggleAllocCard(id) {
            var d = document.getElementById('alloc-details-' + id);
            var i = document.querySelector('.toggle-alloc-icon-' + id);
            bootstrap.Collapse.getOrCreateInstance(d).toggle();
            i.style.transform = d.classList.contains('show') ? 'rotate(0deg)' : 'rotate(180deg)';
        }
    </script>
}