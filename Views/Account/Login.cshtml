@{
    ViewData["Title"] = "System Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card card-industrial">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <i class="fa-solid fa-oil-well text-warning fa-3x mb-2"></i>
                    <h4 class="fw-bold" style="color: var(--refinery-navy);">REFINERY OPERATIONS PORTAL</h4>
                    <p class="text-muted small">Conference Room & Facilities Scheduling</p>
                </div>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Corporate Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fa-solid fa-envelope text-muted"></i></span>
                            <input type="email" name="email" class="form-control" placeholder="user@refinery.com" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fa-solid fa-lock text-muted"></i></span>
                            <input type="password" name="password" class="form-control" placeholder="••••••••••••" required />
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-amber py-2"><i class="fa-solid fa-right-to-bracket me-2"></i> SECURE SIGN IN</button>
                    </div>
                </form>

                <hr class="my-4" />
                
                <div class="bg-light p-3 rounded small border">
                    <strong class="text-dark d-block mb-1"><i class="fa-solid fa-key me-1 text-warning"></i> Pre-Seeded Testing Accounts:</strong>
                    <span class="d-block text-muted">Password for all: <code>Refinery2026!</code></span>
                    <ul class="mb-0 mt-1 ps-3 text-secondary">
                        <li><strong>Admin:</strong> admin@refinery.com</li>
                        <li><strong>Allocator:</strong> allocator@refinery.com</li>
                        <li><strong>IT/Facilities:</strong> itfm@refinery.com</li>
                        <li><strong>General User:</strong> user@refinery.com</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>