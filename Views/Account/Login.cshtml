@{
    ViewData["Title"] = "Sign In";
    Layout = null; // Full custom login page
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — NRL Conference Booking System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        body {
            background-color: #f0f2f5;
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .login-header {
            background-color: #0b2553;
            padding: 14px 32px;
            display: flex;
            align-items: center;
            gap: 14px;
            border-bottom: 3px solid #1a4090;
        }
        .login-header img { height: 40px; filter: brightness(0) invert(1); }
        .login-header .site-title {
            color: rgba(255,255,255,0.95);
            font-size: 0.88rem;
            font-weight: 600;
            line-height: 1.3;
            letter-spacing: 0.03em;
        }
        .login-header .site-subtitle {
            font-size: 0.72rem;
            color: rgba(255,255,255,0.55);
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }
        .login-wrap {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 16px;
        }
        .login-card {
            background: #fff;
            border-top: 4px solid #0b2553;
            border-radius: 2px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 420px;
        }
        .login-card-head {
            background-color: #0b2553;
            padding: 24px 32px 20px;
            text-align: center;
        }
        .login-card-head img { height: 52px; filter: brightness(0) invert(1); margin-bottom: 10px; }
        .login-card-head h5 {
            color: #fff;
            font-size: 1rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            margin-bottom: 2px;
        }
        .login-card-head p {
            color: rgba(255,255,255,0.55);
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            margin: 0;
        }
        .login-card-body { padding: 28px 32px; }
        .form-label { font-size: 0.8rem; font-weight: 600; color: #1a2a40; }
        .form-control {
            border-radius: 2px;
            border-color: #c8d0dc;
            font-size: 0.875rem;
        }
        .form-control:focus {
            border-color: #0b2553;
            box-shadow: 0 0 0 0.15rem rgba(11,37,83,0.18);
        }
        .btn-signin {
            background-color: #0b2553;
            color: #fff;
            border: none;
            border-radius: 2px;
            font-weight: 700;
            font-size: 0.85rem;
            letter-spacing: 0.06em;
            padding: 10px;
        }
        .btn-signin:hover { background-color: #081c3e; color: #fff; }
        .login-footer {
            background-color: #0b2553;
            color: rgba(255,255,255,0.4);
            text-align: center;
            font-size: 0.72rem;
            padding: 10px;
            letter-spacing: 0.03em;
        }
        .test-accounts {
            background-color: #f7f9fc;
            border: 1px solid #d0d7e3;
            border-left: 3px solid #0b2553;
            padding: 12px 14px;
            font-size: 0.78rem;
            border-radius: 2px;
        }
        .test-accounts code { color: #0b2553; background: #e8ecf5; padding: 1px 5px; border-radius: 2px; }
    </style>
</head>
<body>
    <!-- Top header bar -->
    <div class="login-header">
        <img src="~/images/nrl-og-logo.png" alt="NRL Logo" />
        <div>
            <div class="site-title">NRL Conference Booking System</div>
            <div class="site-subtitle">Numaligarh Refinery Limited &nbsp;|&nbsp; Internal Use Only</div>
        </div>
    </div>

    <div class="login-wrap">
        <div class="login-card">
            <div class="login-card-head">
                <img src="~/images/nrl-og-logo.png" alt="NRL" />
                <h5>CONFERENCE BOOKING SYSTEM</h5>
                <p>Authorised Personnel Only</p>
            </div>
            <div class="login-card-body">
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label">Corporate Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light" style="border-radius:2px 0 0 2px;">
                                <i class="fa-solid fa-envelope text-muted small"></i>
                            </span>
                            <input type="email" name="email" class="form-control" placeholder="user@nrl.co.in" required autofocus />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light" style="border-radius:2px 0 0 2px;">
                                <i class="fa-solid fa-lock text-muted small"></i>
                            </span>
                            <input type="password" name="password" class="form-control" placeholder="••••••••••" required />
                        </div>
                    </div>

                    <div class="d-grid mb-4">
                        <button type="submit" class="btn btn-signin">
                            <i class="fa-solid fa-right-to-bracket me-2"></i> SIGN IN
                        </button>
                    </div>

                    <div class="test-accounts">
                        <strong style="color:#0b2553;display:block;margin-bottom:6px;">
                            <i class="fa-solid fa-key me-1"></i> Test Accounts (Password: <code>Refinery2026!</code>)
                        </strong>
                        <div class="row g-1" style="color:#4a5568;">
                            <div class="col-6">Admin: <em>admin@refinery.com</em></div>
                            <div class="col-6">Allocator: <em>allocator@refinery.com</em></div>
                            <div class="col-6">ITFM: <em>itfm@refinery.com</em></div>
                            <div class="col-6">User: <em>user@refinery.com</em></div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="login-footer">
        <img src="~/images/nrl-og-logo.png" alt="NRL" style="height:14px;filter:brightness(0) invert(1);opacity:0.5;vertical-align:middle;margin-right:6px;" />
        NRL Conference Booking System &nbsp;|&nbsp; &copy; @DateTime.Now.Year Numaligarh Refinery Limited. All rights reserved.
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>