@{
    ViewData["Title"] = "Sign In";
    Layout = null; // Full custom login page
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — Conference Hall Booking System</title>
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/nrl-og-logo.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        body {
            background-color: #f0f2f5;
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .login-header {
            background-color: #0b2553;
            padding: 12px 32px;
            display: flex;
            align-items: center;
            gap: 14px;
            border-bottom: 3px solid #0b2553;
        }
        .login-header img {
            height: 42px;
            background: #ffffff;
            padding: 2px 6px;
            border-radius: 2px;
        }
        .login-header .site-title {
            color: #ffffff;
            font-size: 0.9rem;
            font-weight: 700;
            line-height: 1.3;
            letter-spacing: 0.03em;
        }
        .login-header .site-subtitle {
            font-size: 0.72rem;
            color: rgba(255,255,255,0.75);
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }
        .login-wrap {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 16px;
        }
        .login-card {
            background: #fff;
            border-top: none !important;
            border-radius: 2px;
            box-shadow: none !important;
            border-left: 1px solid #d0d7e3;
            border-right: 1px solid #d0d7e3;
            border-bottom: 1px solid #d0d7e3;
            width: 100%;
            max-width: 420px;
        }
        .login-card-head {
            background-color: #0b2553;
            padding: 24px 32px 20px;
            text-align: center;
            border-top: none !important;
            border-bottom: 3px solid #eb5d31 !important;
        }
        .login-card-head img {
            height: 50px;
            background: #ffffff;
            padding: 3px 8px;
            border-radius: 2px;
            margin-bottom: 12px;
        }
        .login-card-head h5 {
            color: #fff;
            font-size: 0.95rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            margin-bottom: 2px;
        }
        .login-card-head p {
            color: rgba(255,255,255,0.75);
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            margin: 0;
        }
        .login-card-body { padding: 28px 32px; }
        .form-label { font-size: 0.8rem; font-weight: 600; color: #1a2a40; }
        .form-control {
            border-radius: 2px;
            border-color: #c8d0dc;
            font-size: 0.875rem;
            box-shadow: none !important;
        }
        .form-control:focus {
            border-color: #0b2553 !important;
            box-shadow: none !important;
        }
        .btn-signin {
            background-color: #0b2553;
            color: #fff;
            border: none;
            border-radius: 2px;
            font-weight: 700;
            font-size: 0.85rem;
            letter-spacing: 0.06em;
            padding: 10px;
            box-shadow: none !important;
        }
        .btn-signin:hover { background-color: #05142e; color: #fff; }
        .login-footer {
            background-color: #0b2553;
            color: rgba(255,255,255,0.75);
            text-align: center;
            font-size: 0.72rem;
            padding: 10px;
            letter-spacing: 0.03em;
        }
        .login-footer img {
            height: 18px;
            background: #ffffff;
            padding: 1px 4px;
            border-radius: 2px;
            vertical-align: middle;
            margin-right: 8px;
        }
        .test-accounts {
            background-color: #f7f9fc;
            border: 1px solid #d0d7e3;
            border-left: 3px solid #0b2553;
            padding: 12px 14px;
            font-size: 0.78rem;
            border-radius: 2px;
        }
        .test-accounts code { color: #0b2553; background: #e8ecf5; padding: 1px 5px; border-radius: 2px; }
    </style>
</head>
<body>
    <header class="nrl-header-exact">
        <div class="header-wrapper">
            <!-- Left Logo Area with Slant -->
            <div class="header-left-logo">
                <a asp-controller="Home" asp-action="Index" class="logo-content">
                    <div class="logo-text-block">
                        <div class="logo-title">CONFERENCE HALL<br/>BOOKING SYSTEM</div>
                        <div class="logo-gov">NRL INTERNAL SYSTEM</div>
                    </div>
                    <div class="logo-divider"></div>
                    <img src="~/images/nrl-og-logo.png" class="logo-img" alt="NRL Logo">
                </a>
            </div>
            
            <!-- Right Content Area -->
            <div class="header-right-content">
                <!-- Top Utility Bar (Navy) -->
                <div class="header-utility">
                    <div class="utility-left">
                        <span></span>
                    </div>
                    <div class="utility-right">
                        <span>Skip to main content</span>
                        <span>|</span>
                        <span>A+ A A-</span>
                        <span>|</span>
                        <i class="fa-solid fa-wheelchair"></i>
                        <span>|</span>
                        <i class="fa-solid fa-circle-half-stroke"></i>
                        <span style="color: yellow;"><i class="fa-solid fa-circle-half-stroke"></i></span>
                        <span>|</span>
                    </div>
                </div>
                
                <!-- Bottom Navigation Bar (White) -->
                <div class="header-nav">
                </div>
            </div>
        </div>
        <!-- Orange Bottom Line -->
        <div class="header-bottom-line"></div>
    </header>

    <div class="login-wrap">
        <div class="login-card">
            <div class="login-card-head">
                <img src="~/images/nrl-og-logo.png" alt="NRL Logo" />
                <h5>CONFERENCE HALL BOOKING SYSTEM</h5>
                <p>Authorised Personnel Only</p>
            </div>
            <div class="login-card-body">
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label">Windows Username</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light" style="border-radius:2px 0 0 2px;">
                                <i class="fa-solid fa-id-card text-muted small"></i>
                            </span>
                            <input type="text" name="userId" class="form-control" placeholder="e.g. john.doe" required autofocus autocomplete="username" />
                        </div>
                        <div class="form-text text-muted" style="font-size:0.72rem;margin-top:4px;">
                            Use your company computer login username
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light" style="border-radius:2px 0 0 2px;">
                                <i class="fa-solid fa-lock text-muted small"></i>
                            </span>
                            <input type="password" name="password" class="form-control" placeholder="••••••••••" required />
                        </div>
                    </div>

                    <div class="d-grid mb-4">
                        <button type="submit" class="btn btn-signin">
                            <i class="fa-solid fa-right-to-bracket me-2"></i> SIGN IN
                        </button>
                    </div>

                    <div class="test-accounts">
                        <strong style="color:#0b2553;display:block;margin-bottom:6px;">
                            <i class="fa-solid fa-key me-1"></i> Default System Accounts (Password: <code>Refinery2026!</code>)
                        </strong>
                        <div class="row g-1" style="color:#4a5568;">
                            <div class="col-6">Admin: <em>sys.admin</em></div>
                            <div class="col-6">Allocator: <em>sarah.jenkins</em></div>
                            <div class="col-6">ITFM: <em>marcus.vance</em></div>
                            <div class="col-6">User: <em>dave.miller</em></div>
                        </div>
                        <div style="margin-top:8px;font-size:0.7rem;color:#6b7280;border-top:1px solid #e5e7eb;padding-top:6px;">
                            <i class="fa-solid fa-circle-info me-1"></i>
                            Regular employees use their company computer username &amp; password.
                            Name &amp; department are fetched automatically from the company server.
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="login-footer">
        <img src="~/images/nrl-og-logo.png" alt="NRL Logo" />
        Conference Hall Booking System &nbsp;|&nbsp; &copy; @DateTime.Now.Year Numaligarh Refinery Limited. All rights reserved.
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>