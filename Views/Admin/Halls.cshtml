@model IEnumerable<RefineryBooking.Models.ConferenceRoom>
@{
    ViewData["Title"] = "Conference Halls";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:var(--nrl-navy);">
            <i class="fa-solid fa-building me-2"></i>Conference Halls
        </h4>
        <p class="text-muted small mb-0">Manage all conference rooms and facilities across the refinery.</p>
    </div>
    <a asp-action="AddHall" class="btn btn-nrl-primary shadow-sm">
        <i class="fa-solid fa-plus me-1"></i>Add New Hall
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 small">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2 small">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card card-industrial">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Hall Code</th>
                        <th>Name & Location</th>
                        <th>Department</th>
                        <th>Cost Centre</th>
                        <th>Capacity</th>
                        <th>Equipment</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hall in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="badge bg-light text-dark border font-monospace">@hall.HallCode</span>
                            </td>
                            <td>
                                <div class="fw-bold" style="color:var(--nrl-navy);">@hall.Name</div>
                                <div class="text-muted small">
                                    <i class="fa-solid fa-location-dot me-1"></i>@hall.BuildingLocation
                                    @if(!string.IsNullOrEmpty(hall.FloorNumber))
                                    {
                                        <span> (Floor @hall.FloorNumber)</span>
                                    }
                                </div>
                            </td>
                            <td>@hall.OwnerDepartment</td>
                            <td><span class="font-monospace small">@hall.CostCentreCode</span></td>
                            <td><i class="fa-solid fa-users me-1 text-muted"></i>@hall.Capacity</td>
                            <td>
                                <div class="d-flex gap-1">
                                    @if (hall.HasProjector) { <span class="badge bg-light text-dark border" title="Projector"><i class="fa-solid fa-video"></i></span> }
                                    @if (hall.HasVideoConferencing) { <span class="badge bg-light text-dark border" title="Video Conferencing"><i class="fa-solid fa-desktop"></i></span> }
                                    @if (hall.HasWhiteboard) { <span class="badge bg-light text-dark border" title="Whiteboard"><i class="fa-solid fa-chalkboard"></i></span> }
                                </div>
                            </td>
                            <td>
                                @if (hall.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="EditHall" asp-route-id="@hall.Id" class="btn btn-sm btn-outline-primary me-1" title="Edit details">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <form asp-action="ToggleHall" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@hall.Id" />
                                    @if (hall.IsActive)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Deactivate Hall" onclick="return confirm('Are you sure you want to deactivate this hall? It will no longer be available for booking.')">
                                            <i class="fa-solid fa-ban"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Reactivate Hall">
                                            <i class="fa-solid fa-check"></i>
                                        </button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
