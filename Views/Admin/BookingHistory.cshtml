@model IEnumerable<RefineryBooking.Models.Booking>
@{
    ViewData["Title"] = "Global Booking History";
    int currentPage = ViewBag.CurrentPage;
    bool hasNextPage = ViewBag.HasNextPage;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0" style="color: var(--nrl-navy);">
            <i class="fa-solid fa-clock-rotate-left text-info me-2"></i> Global Booking History
        </h2>
        <p class="text-muted mb-0">System-wide log of all conference hall booking requests.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa-solid fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card card-industrial shadow-sm mb-4">
    <div class="card-body bg-light">
        <form method="get" asp-action="BookingHistory" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label fw-bold text-muted small">Filter by Hall Name</label>
                <div class="input-group shadow-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="searchHallName" class="form-control border-start-0" placeholder="e.g. Board Room..." value="@ViewBag.SearchHallName">
                </div>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary fw-bold px-4 shadow-sm">Search</button>
                @if (!string.IsNullOrEmpty(ViewBag.SearchHallName))
                {
                    <a asp-action="BookingHistory" class="btn btn-outline-secondary ms-2 fw-bold">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="row row-cols-1 g-3">
    @if (!Model.Any())
    {
        <div class="col">
            <div class="alert alert-secondary text-center py-4">
                <i class="fa-solid fa-folder-open fa-2x mb-2 text-muted"></i>
                <h5 class="fw-bold text-muted">No Bookings Found</h5>
                <p class="mb-0 text-muted">Try adjusting your search criteria or check back later.</p>
            </div>
        </div>
    }
    else
    {
        @foreach (var booking in Model)
        {
            string statusColor = booking.Status switch
            {
                RefineryBooking.Models.BookingStatus.Approved => "success",
                RefineryBooking.Models.BookingStatus.Rejected => "danger",
                RefineryBooking.Models.BookingStatus.Cancelled => "secondary",
                RefineryBooking.Models.BookingStatus.PendingAllocatorReview => "info",
                _ => "warning text-dark"
            };

            <div class="col">
                <div class="card shadow-sm border-start border-4 border-@statusColor" style="border-radius: 4px; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='scale(1.01)'; this.classList.add('shadow');" onmouseout="this.style.transform='scale(1)'; this.classList.remove('shadow');" onclick="window.location.href='@Url.Action("Details", "Allocator", new { id = booking.Id })';">
                    <div class="card-body p-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                        
                        <div class="d-flex align-items-start gap-3">
                            <div class="flex-shrink-0">
                                <span class="badge bg-@statusColor px-2 py-2" style="width: 110px; text-align: center;">
                                    @if(booking.Status == RefineryBooking.Models.BookingStatus.Pending) { <i class="fa-solid fa-hourglass-half me-1"></i> }
                                    @if(booking.Status == RefineryBooking.Models.BookingStatus.Approved) { <i class="fa-solid fa-check me-1"></i> }
                                    @if(booking.Status == RefineryBooking.Models.BookingStatus.Rejected) { <i class="fa-solid fa-xmark me-1"></i> }
                                    @booking.Status
                                </span>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1" style="color: var(--nrl-navy);">
                                    <span class="badge bg-dark me-2">BKG-@booking.Id</span>
                                    @booking.MeetingTitle
                                </h6>
                                <div class="text-muted small">
                                    <i class="fa-solid fa-user me-1"></i> @booking.OrganizerName (@booking.Department)
                                    <span class="mx-2">|</span>
                                    <i class="fa-solid fa-door-open me-1"></i> <strong>@booking.ConferenceRoom?.Name</strong>
                                </div>
                            </div>
                        </div>

                        <div class="text-md-end text-muted small">
                            <div class="fw-bold text-dark">
                                <i class="fa-regular fa-calendar-days me-1"></i> @booking.StartTime.ToString("MMM dd, yyyy")
                            </div>
                            <div class="mb-2">
                                <i class="fa-regular fa-clock me-1"></i> @booking.StartTime.ToString("HH:mm") - @booking.EndTime.ToString("HH:mm")
                            </div>

                            @if (booking.Status == RefineryBooking.Models.BookingStatus.Cancelled || booking.Status == RefineryBooking.Models.BookingStatus.Rejected)
                            {
                                @if (!string.IsNullOrEmpty(booking.RejectionReason))
                                {
                                    <div class="small text-danger fst-italic">@booking.RejectionReason</div>
                                }
                            }
                            else if (booking.EndTime > DateTime.Now)
                            {
                                <form asp-action="CancelBooking" asp-route-id="@booking.Id" method="post" onclick="event.stopPropagation();" onsubmit="return confirm('Are you sure you want to cancel this booking? This action cannot be undone.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger mt-1"><i class="fa-solid fa-ban"></i> Cancel Booking</button>
                                </form>
                            }
                        </div>

                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- Pagination Controls -->
<div class="d-flex justify-content-center mt-4">
    <div class="btn-group shadow-sm">
        @if (currentPage > 1)
        {
            <a asp-action="BookingHistory" asp-route-page="@(currentPage - 1)" asp-route-searchHallName="@ViewBag.SearchHallName" class="btn btn-outline-primary fw-bold">
                <i class="fa-solid fa-chevron-left me-1"></i> Previous
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary fw-bold" disabled>
                <i class="fa-solid fa-chevron-left me-1"></i> Previous
            </button>
        }

        <button class="btn btn-primary fw-bold" disabled style="opacity: 1;">
            Page @currentPage
        </button>

        @if (hasNextPage)
        {
            <a asp-action="BookingHistory" asp-route-page="@(currentPage + 1)" asp-route-searchHallName="@ViewBag.SearchHallName" class="btn btn-outline-primary fw-bold">
                Next <i class="fa-solid fa-chevron-right ms-1"></i>
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary fw-bold" disabled>
                Next <i class="fa-solid fa-chevron-right ms-1"></i>
            </button>
        }
    </div>
</div>
