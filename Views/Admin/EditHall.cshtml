@model RefineryBooking.Models.ConferenceRoom
@{
    ViewData["Title"] = "Edit Hall";
    var depts = ViewBag.Departments as List<string> ?? new();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-industrial">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold" style="color:var(--nrl-navy);">
                    <i class="fa-solid fa-pen me-2"></i>Edit Conference Hall
                </h5>
                <a asp-action="Halls" class="btn btn-sm btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i>Back to Halls
                </a>
            </div>
            <div class="card-body p-4">
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 small">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>Please correct the errors below.
                    </div>
                }

                <form asp-action="EditHall" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="IsActive" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <input type="hidden" asp-for="CreatedByUserId" />

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Hall Name *</label>
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Hall Code *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-barcode text-muted small"></i></span>
                                <input asp-for="HallCode" class="form-control font-monospace" required />
                            </div>
                            <span asp-validation-for="HallCode" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Owner Department *</label>
                            <select asp-for="OwnerDepartment" class="form-select searchable-select" required>
                                <option value="">Select Department...</option>
                                @foreach (var d in depts)
                                {
                                    <option value="@d">@d</option>
                                }
                            </select>
                            <span asp-validation-for="OwnerDepartment" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Cost Centre Code *</label>
                            <input asp-for="CostCentreCode" class="form-control font-monospace" required pattern="[0-9]{1,4}" title="Numeric code up to 4 digits" />
                            <span asp-validation-for="CostCentreCode" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Building / Location *</label>
                            <input asp-for="BuildingLocation" class="form-control" required />
                            <span asp-validation-for="BuildingLocation" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Floor</label>
                            <input asp-for="FloorNumber" class="form-control" />
                            <span asp-validation-for="FloorNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Capacity *</label>
                            <input asp-for="Capacity" type="number" min="1" max="500" class="form-control" required />
                            <span asp-validation-for="Capacity" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold d-block mb-3">Available Equipment</label>
                        <div class="d-flex gap-4">
                            <div class="form-check form-switch">
                                <input asp-for="HasProjector" class="form-check-input" type="checkbox" role="switch" />
                                <label class="form-check-label" asp-for="HasProjector"><i class="fa-solid fa-video me-1"></i>Projector</label>
                            </div>
                            <div class="form-check form-switch">
                                <input asp-for="HasVideoConferencing" class="form-check-input" type="checkbox" role="switch" />
                                <label class="form-check-label" asp-for="HasVideoConferencing"><i class="fa-solid fa-desktop me-1"></i>Video Conferencing</label>
                            </div>
                            <div class="form-check form-switch">
                                <input asp-for="HasWhiteboard" class="form-check-input" type="checkbox" role="switch" />
                                <label class="form-check-label" asp-for="HasWhiteboard"><i class="fa-solid fa-chalkboard me-1"></i>Whiteboard</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Description / Notes</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-4">
                        <a asp-action="Halls" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-nrl-primary px-4">
                            <i class="fa-solid fa-floppy-disk me-1"></i>Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

