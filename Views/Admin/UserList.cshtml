@model IEnumerable<RefineryBooking.Models.ApplicationUser>
@{
    ViewData["Title"] = "User Management";
    var userRoles = ViewBag.UserRoles as Dictionary<string, string> ?? new();
    var hallCounts = ViewBag.HallCounts as Dictionary<string, int> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:var(--nrl-navy);">
            <i class="fa-solid fa-users-gear me-2"></i>User Management
        </h4>
        <p class="text-muted small mb-0">Create users, assign system roles, and manage access.</p>
    </div>
    <a asp-action="CreateUser" class="btn btn-nrl-primary">
        <i class="fa-solid fa-user-plus me-1"></i>Create New User
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
        <i class="fa-solid fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card card-industrial">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Full Name</th>
                        <th>Windows Username</th>
                        <th>Badge ID</th>
                        <th>Department</th>
                        <th>Role</th>
                        <th>Halls</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        var role = userRoles.ContainsKey(u.Id) ? userRoles[u.Id] : "—";
                        var isLocked = u.LockoutEnabled && u.LockoutEnd.HasValue && u.LockoutEnd.Value > DateTimeOffset.UtcNow;
                        var roleBadge = role switch {
                            "Admin"     => "bg-danger",
                            "Allocator" => "bg-primary",
                            "ITFM"      => "bg-info text-white",
                            _           => "bg-secondary"
                        };

                        <tr>
                            <td class="fw-bold">@u.FullName</td>
                            <td><span class="font-monospace small">@u.UserName</span></td>
                            <td><span class="badge bg-light text-dark border">@u.EmployeeBadgeId</span></td>
                            <td>@u.Department</td>
                            <td><span class="badge @roleBadge">@role</span></td>
                            <td>
                                @if (role == "Allocator")
                                {
                                    var count = hallCounts.ContainsKey(u.Id) ? hallCounts[u.Id] : 0;
                                    if (count == 0)
                                    {
                                        <span class="badge bg-warning text-dark"
                                              title="No halls assigned yet">
                                            <i class="fa-solid fa-triangle-exclamation me-1"></i>None
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@count hall@(count == 1 ? "" : "s")</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>
                                @if (isLocked)
                                {
                                    <span class="badge bg-danger">Deactivated</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-secondary me-1"
                                        data-bs-toggle="modal" data-bs-target="#roleModal-@u.Id">
                                    <i class="fa-solid fa-user-shield me-1"></i>Role
                                </button>
                                @if (role == "Allocator")
                                {
                                    <a asp-action="ManageAllocatorHalls" asp-route-userId="@u.Id"
                                       class="btn btn-sm btn-outline-primary me-1"
                                       title="Assign/remove halls for this allocator">
                                        <i class="fa-solid fa-building-lock me-1"></i>Halls
                                    </a>
                                }
                                @if (isLocked)
                                {
                                    <form asp-action="ReactivateUser" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">Reactivate</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="DeactivateUser" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                                    </form>
                                }
                            </td>
                        </tr>

                        <!-- Role Modal -->
                        <div class="modal fade" id="roleModal-@u.Id" tabindex="-1">
                            <div class="modal-dialog modal-sm text-start">
                                <form asp-action="ChangeRole" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <div class="modal-content">
                                        <div class="modal-header py-2" style="background:var(--nrl-navy);">
                                            <h6 class="modal-title text-white">Change Role: @u.FullName</h6>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <label class="form-label fw-bold small">Select Role</label>
                                            <select name="newRole" class="form-select form-select-sm">
                                                <option value="User" selected="@(role=="User")">User (General Employee)</option>
                                                <option value="Allocator" selected="@(role=="Allocator")">Allocator (Room Approver)</option>
                                                <option value="ITFM" selected="@(role=="ITFM")">ITFM (AV & Facilities)</option>
                                                <option value="Admin" selected="@(role=="Admin")">Admin (System Manager)</option>
                                            </select>
                                        </div>
                                        <div class="modal-footer py-2">
                                            <button class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-sm btn-nrl-primary">Save Role</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
