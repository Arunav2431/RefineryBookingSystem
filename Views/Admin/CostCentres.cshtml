@model IEnumerable<RefineryBooking.Models.CostCentre>
@{
    ViewData["Title"] = "Manage Cost Centres";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold" style="color:var(--nrl-navy);">
        <i class="fa-solid fa-coins me-2"></i>Cost Centres
    </h4>
    <a asp-action="AddCostCentre" class="btn btn-nrl-primary">
        <i class="fa-solid fa-plus me-1"></i> Add New Cost Centre
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card card-industrial">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Code</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cc in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold">@cc.Code</td>
                        <td>@cc.Name</td>
                        <td class="text-muted small">@cc.Description</td>
                        <td>
                            @if (cc.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25"><i class="fa-solid fa-check me-1"></i>Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25"><i class="fa-solid fa-ban me-1"></i>Inactive</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <a asp-action="EditCostCentre" asp-route-id="@cc.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                            <form asp-action="ToggleCostCentre" asp-route-id="@cc.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(cc.IsActive ? "btn-outline-danger" : "btn-outline-success")" 
                                        title="@(cc.IsActive ? "Deactivate" : "Activate")">
                                    <i class="fa-solid @(cc.IsActive ? "fa-ban" : "fa-check")"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No Cost Centres found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
