@{
    ViewData["Title"] = "Create System Account";
    var roles = ViewBag.Roles as List<string> ?? new();
    var depts = ViewBag.Departments as List<string> ?? new();
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-industrial">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold" style="color:var(--nrl-navy);">
                    <i class="fa-solid fa-user-gear me-2"></i>Create System Role Account
                </h5>
                <a asp-action="Users" class="btn btn-sm btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i>Back to Users
                </a>
            </div>
            <div class="card-body p-4">

                @* Info banner *@
                <div class="alert alert-info d-flex gap-2 py-2 small mb-4" style="border-left:3px solid #0b2553;border-radius:2px;">
                    <i class="fa-solid fa-circle-info mt-1"></i>
                    <div>
                        <strong>For system role accounts only.</strong><br/>
                        Regular employees (bookers) <strong>do not need to be created here</strong> —
                        they log in automatically using their <strong>company computer username &amp; password</strong>.
                        Their name and department are pulled from the company server on first login.
                    </div>
                </div>

                <form asp-action="CreateUser" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-bold">Full Name *</label>
                        <input type="text" name="fullName" class="form-control" placeholder="e.g. Ramesh Chandra Sharma" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Windows Username *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light" style="border-radius:2px 0 0 2px;">
                                <i class="fa-solid fa-id-card text-muted small"></i>
                            </span>
                            <input type="text" name="windowsUsername" class="form-control"
                                   placeholder="e.g. ramesh.sharma" required
                                   pattern="[a-zA-Z0-9.\-_]+"
                                   title="Use the employee's Windows/domain login username (e.g. john.doe)" />
                        </div>
                        <div class="form-text text-muted" style="font-size:0.75rem;">
                            The employee's company computer login username (e.g. <code>john.doe</code>)
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Employee Badge ID</label>
                            <input type="text" name="employeeBadgeId" class="form-control" placeholder="e.g. NRL-1042" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Department *</label>
                            <select name="department" class="form-select" required>
                                <option value="">Select Department...</option>
                                @foreach (var d in depts)
                                {
                                    <option value="@d">@d</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">System Role *</label>
                        <select name="role" class="form-select" required>
                            @foreach (var r in roles)
                            {
                                <option value="@r">
                                    @(r == "Admin" ? "Admin — Full system administration" :
                                      r == "Allocator" ? "Allocator — Manages & approves room bookings" :
                                      r == "ITFM" ? "ITFM — Prepares AV/IT equipment for meetings" : r)
                                </option>
                            }
                        </select>
                        <div class="form-text text-muted" style="font-size:0.75rem;">
                            <i class="fa-solid fa-circle-info me-1"></i>
                            "User" role is not listed — regular employees log in automatically via the company network.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Initial Password *</label>
                        <input type="password" name="password" class="form-control" placeholder="••••••••••••" required />
                        <span class="text-muted small">Min. 8 characters with uppercase, digit and special character.</span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Users" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-nrl-primary px-4">
                            <i class="fa-solid fa-user-check me-1"></i>Create Account
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

