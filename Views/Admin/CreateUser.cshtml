@{
    ViewData["Title"] = "Create User";
    var roles = ViewBag.Roles as List<string> ?? new();
    var depts = ViewBag.Departments as List<string> ?? new();
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-industrial">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold" style="color:var(--nrl-navy);">
                    <i class="fa-solid fa-user-plus me-2"></i>Create System Account
                </h5>
                <a asp-action="Users" class="btn btn-sm btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i>Back to Users
                </a>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateUser" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-bold">Full Name *</label>
                        <input type="text" name="fullName" class="form-control" placeholder="e.g. Ramesh Chandra Sharma" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Corporate Email *</label>
                        <input type="email" name="email" class="form-control" placeholder="username@nrl.co.in" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Employee Badge ID</label>
                            <input type="text" name="employeeBadgeId" class="form-control" placeholder="e.g. REF-1042" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Department *</label>
                            <select name="department" class="form-select" required>
                                <option value="">Select Department...</option>
                                @foreach (var d in depts)
                                {
                                    <option value="@d">@d</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">System Role *</label>
                        <select name="role" class="form-select" required>
                            <option value="User">User — Standard room booking requester</option>
                            <option value="Allocator">Allocator — Manages & approves room bookings</option>
                            <option value="ITFM">ITFM — Prepares AV/IT equipment for meetings</option>
                            <option value="Admin">Admin — Full system administration</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Initial Password *</label>
                        <input type="password" name="password" class="form-control" placeholder="••••••••••••" required />
                        <span class="text-muted small">Must be at least 6 characters with upper/lowercase and digit/special char.</span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Users" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-nrl-primary px-4">
                            <i class="fa-solid fa-user-check me-1"></i>Create Account
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
