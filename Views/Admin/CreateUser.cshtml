@{
    ViewData["Title"] = "Create System Account";
    var roles = ViewBag.Roles as List<string> ?? new();
    var allRooms = ViewBag.AllRooms as List<RefineryBooking.Models.ConferenceRoom> ?? new();
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card card-industrial">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold" style="color:var(--nrl-navy);">
                    <i class="fa-solid fa-user-gear me-2"></i>Create System Role Account
                </h5>
                <a asp-action="Users" class="btn btn-sm btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i>Back to Users
                </a>
            </div>
            <div class="card-body p-4">

                @* Info banner *@
                <div class="alert alert-info d-flex gap-2 py-2 small mb-4" style="border-left:3px solid #0b2553;border-radius:2px;">
                    <i class="fa-solid fa-circle-info mt-1"></i>
                    <div>
                        <strong>For system role accounts only.</strong><br/>
                        Regular employees (bookers) <strong>do not need to be created here</strong> —
                        they log in automatically using their <strong>company computer username &amp; password</strong>.
                        Their name and department are pulled from the company server on first login.
                    </div>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger py-2 small">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
                    </div>
                }

                <form asp-action="CreateUser" method="post" id="createUserForm">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-bold">Windows Username *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light" style="border-radius:2px 0 0 2px;">
                                <i class="fa-solid fa-id-card text-muted small"></i>
                            </span>
                            <input type="text" name="windowsUsername" class="form-control"
                                   placeholder="e.g. ramesh.sharma" required
                                   pattern="[a-zA-Z0-9.\-_]+"
                                   title="Use the employee's Windows/domain login username (e.g. john.doe)" />
                        </div>
                        <div class="form-text text-muted" style="font-size:0.75rem;">
                            The employee's company computer login username (e.g. <code>john.doe</code>).
                            Full Name &amp; Department are fetched automatically from the company server.
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Employee Badge ID</label>
                            <input type="text" name="employeeBadgeId" class="form-control" placeholder="e.g. NRL-1042" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">System Role *</label>
                            <select name="role" id="roleSelect" class="form-select searchable-select" required onchange="toggleHallSection()">
                                @foreach (var r in roles)
                                {
                                    <option value="@r">
                                        @(r == "Admin" ? "Admin — Full system administration" :
                                          r == "Allocator" ? "Allocator — Manages & approves room bookings" :
                                          r == "ITFM" ? "ITFM — Prepares AV/IT equipment for meetings" : r)
                                    </option>
                                }
                            </select>
                            <div class="form-text text-muted" style="font-size:0.75rem;">
                                <i class="fa-solid fa-circle-info me-1"></i>
                                "User" is not listed — regular employees log in automatically.
                            </div>
                        </div>
                    </div>

                    @* Hall Assignment — required only for Allocator *@
                    <div id="hallSection" class="mb-4 p-3 rounded border"
                         style="background:#f8fafc; display:none;">
                        <label class="form-label fw-bold mb-2">
                            <i class="fa-solid fa-building-lock me-1 text-primary"></i>
                            Assign Conference Halls <span class="text-danger">*</span>
                        </label>
                        <div class="form-text text-muted mb-3" style="font-size:0.78rem;">
                            An Allocator <strong>must be assigned to at least one hall</strong>.
                            They will only see and approve bookings for their assigned halls.
                        </div>
                        <div class="mb-2">
                            <select class="form-control select2-halls" name="selectedRoomIds" id="selectedRoomIds" multiple="multiple" style="width: 100%;">
                                @foreach (var room in allRooms)
                                {
                                    <option value="@room.Id">@room.Name (@room.BuildingLocation | @room.Capacity seats)</option>
                                }
                            </select>
                        </div>
                        <div id="hallError" class="text-danger small mt-2" style="display:none;">
                            <i class="fa-solid fa-triangle-exclamation me-1"></i>
                            Please select at least one hall for an Allocator.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Initial Password *</label>
                        <input type="password" name="password" class="form-control" placeholder="••••••••••••" required />
                        <span class="text-muted small">Min. 8 characters with uppercase, digit and special character.</span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Users" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-nrl-primary px-4" onclick="return validateForm()">
                            <i class="fa-solid fa-user-check me-1"></i>Create Account
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleHallSection() {
        const role = document.getElementById('roleSelect').value;
        const section = document.getElementById('hallSection');
        section.style.display = role === 'Allocator' ? 'block' : 'none';
        document.getElementById('hallError').style.display = 'none';
    }

    function toggleHallCard(roomId) {
        const cb = document.getElementById('hroom-' + roomId);
        const card = document.getElementById('hcard-' + roomId);
        card.classList.toggle('border-primary', cb.checked);
        card.classList.toggle('bg-light', cb.checked);
    }

    function validateForm() {
        const role = document.getElementById('roleSelect').value;
        if (role === 'Allocator') {
            const selectedHalls = $('#selectedRoomIds').val();
            if (!selectedHalls || selectedHalls.length === 0) {
                document.getElementById('hallError').style.display = 'block';
                document.getElementById('hallSection').scrollIntoView({ behavior: 'smooth' });
                return false;
            }
        }
        return true;
    }

    // Show hall section on page load if Allocator is pre-selected
    toggleHallSection();
</script>

@section Scripts {
    <!-- Select2 loaded globally in _Layout.cshtml -->
}
