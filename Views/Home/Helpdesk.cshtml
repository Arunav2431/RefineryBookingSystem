@{
    ViewData["Title"] = "Helpdesk & FAQ";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="card bg-dark text-white border-0 shadow-sm" style="background: linear-gradient(135deg, var(--refinery-navy) 0%, #2c3e50 100%);">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div>
                    <h2 class="fw-bold mb-1"><i class="fa-solid fa-life-ring text-warning me-2"></i> Conference Hall Booking Helpdesk</h2>
                    <p class="mb-0 text-light opacity-75">Frequently Asked Questions and Support</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold" style="color: var(--refinery-navy);"><i class="fa-solid fa-circle-question text-warning me-2"></i> Frequently Asked Questions (FAQ)</h5>
            </div>
            <div class="card-body p-4">
                <div class="accordion" id="faqAccordion">
                    <div class="accordion-item mb-2 border rounded">
                        <h2 class="accordion-header">
                            <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                How far in advance can I book a conference room?
                            </button>
                        </h2>
                        <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                            <div class="accordion-body small text-muted">
                                General users can request room bookings up to <strong>30 days in advance</strong>. If you require a recurring meeting slot beyond 30 days, please contact the support team.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item mb-2 border rounded">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                What happens if I request AV equipment or catering?
                            </button>
                        </h2>
                        <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body small text-muted">
                                When you select equipment on your booking form, the system automatically alerts the facilities team as soon as your booking is approved. The team will prepare the room prior to your meeting.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item mb-2 border rounded">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                Why was my room booking request rejected?
                            </button>
                        </h2>
                        <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body small text-muted">
                                If an Allocator rejects your request, they will provide a reason. You can view this exact rejection reason anytime by navigating to <strong>My Bookings</strong> in the top navigation bar and hovering over the red <em>Rejected</em> badge.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border rounded mb-2">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                                How does real-time room availability verification work?
                            </button>
                        </h2>
                        <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body small text-muted">
                                Our system runs a live check the moment you select a room and time slot. If another meeting is already approved or pending review for that overlapping timeframe, the system immediately alerts you on the form and disables the submit button to prevent double-booking.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border rounded">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq5">
                                Can I edit or cancel a booking after submitting?
                            </button>
                        </h2>
                        <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body small text-muted">
                                Yes. You can cancel your own pending or approved bookings from the <strong>My Bookings</strong> page. If you need to make changes, please cancel the original booking and create a new one.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Need More Help Banner -->
        <div class="card bg-light border p-4 text-center">
            <h6 class="fw-bold" style="color: var(--refinery-navy);">Can't find what you're looking for?</h6>
            <p class="text-muted small mb-3">If you have any other questions, please reach out to our support team.</p>
            <div>
                <a href="mailto:support@dummy-domain.com?subject=Conference%20Room%20Support%20Ticket" class="btn btn-amber btn-sm px-4 fw-bold"><i class="fa-solid fa-envelope me-1"></i> Contact Support (support@dummy-domain.com)</a>
            </div>
        </div>
    </div>
</div>