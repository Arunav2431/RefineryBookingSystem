@model IEnumerable<RefineryBooking.Models.Booking>
@{
    ViewData["Title"] = "Operations Dashboard";
    var isAdmin = User.IsInRole("Admin");
    var isAllocator = User.IsInRole("Allocator");
    var isItfm = User.IsInRole("ITFM");
    var isGeneralUser = !isAdmin && !isAllocator && !isItfm;
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h2 class="fw-bold mb-0" style="color: var(--refinery-navy);">
            @if (isAdmin) { <span><i class="fa-solid fa-user-shield text-danger me-2"></i>System Admin Portal</span> }
            else if (isAllocator) { <span><i class="fa-solid fa-clipboard-check text-warning me-2"></i>Scheduling Allocator Desk</span> }
            else if (isItfm) { <span><i class="fa-solid fa-headset text-info me-2"></i>IT & Facilities Operations</span> }
            else { <span><i class="fa-solid fa-oil-well text-warning me-2"></i>Staff Operations Dashboard</span> }
        </h2>
        <p class="text-muted mb-0">Welcome, <strong>@User.Identity!.Name</strong> | Plant Clock: @DateTime.Now.ToString("dd MMM yyyy, HH:mm")</p>
    </div>
    <div>
        <a asp-controller="Booking" asp-action="Create" class="btn btn-amber shadow-sm fw-bold px-4 py-2"><i class="fa-solid fa-calendar-plus me-1"></i> New Room Request</a>
    </div>
</div>

<!-- ================= 1. ADMIN DASHBOARD ================= -->
@if (isAdmin)
{
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card bg-danger bg-opacity-10 border-danger p-3 shadow-sm">
                <h6 class="text-uppercase text-muted fw-bold mb-1">Total System Users</h6>
                <h2 class="fw-bold mb-0 text-dark">@ViewBag.TotalUsers Active Accounts</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-primary bg-opacity-10 border-primary p-3 shadow-sm">
                <h6 class="text-uppercase text-muted fw-bold mb-1">Conference Rooms</h6>
                <h2 class="fw-bold mb-0 text-dark">@ViewBag.TotalRooms Configured</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success bg-opacity-10 border-success p-3 shadow-sm">
                <h6 class="text-uppercase text-muted fw-bold mb-1">Total Bookings Logged</h6>
                <h2 class="fw-bold mb-0 text-dark">@ViewBag.TotalBookings All-Time</h2>
            </div>
        </div>
    </div>

    <div class="card card-industrial shadow-sm mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold" style="color: var(--refinery-navy);"><i class="fa-solid fa-shield-halved text-danger me-2"></i> Recent Security & Audit Logs</h6>
            <span class="badge bg-secondary">System Monitoring</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Timestamp</th><th>User</th><th>Action</th><th>Details</th></tr>
                </thead>
                <tbody>
                    @if (ViewBag.RecentLogs != null)
                    {
                        foreach (var log in (IEnumerable<RefineryBooking.Models.AuditLog>)ViewBag.RecentLogs)
                        {
                            <tr>
                                <td class="small text-muted">@log.Timestamp.ToLocalTime().ToString("MMM dd, HH:mm:ss")</td>
                                <td class="fw-bold small">@log.UserName</td>
                                <td><span class="badge bg-dark">@log.Action</span></td>
                                <td class="small">@log.Details</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- ================= 2. ALLOCATOR DASHBOARD ================= -->
@if (isAllocator)
{
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card bg-warning bg-opacity-10 border-warning p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-muted fw-bold mb-1">Pending Approval Queue</h6>
                        <h2 class="fw-bold mb-0 text-dark">@ViewBag.PendingCount Requests</h2>
                    </div>
                    <a asp-controller="Allocator" asp-action="Index" class="btn btn-dark fw-bold">Open Queue <i class="fa-solid fa-arrow-right ms-1"></i></a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-success bg-opacity-10 border-success p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-muted fw-bold mb-1">Today's Confirmed Meetings</h6>
                        <h2 class="fw-bold mb-0 text-dark">@ViewBag.TodayCount Booked</h2>
                    </div>
                    <a asp-controller="Booking" asp-action="Calendar" class="btn btn-outline-success fw-bold">View Grid <i class="fa-solid fa-calendar ms-1"></i></a>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-industrial shadow-sm mb-4 border-top border-warning">
        <div class="card-header bg-white py-3">
            <h6 class="mb-0 fw-bold" style="color: var(--refinery-navy);"><i class="fa-solid fa-clock-rotate-left text-warning me-2"></i> Priority Review: Next Pending Requests</h6>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Meeting Title</th><th>Requested By</th><th>Room</th><th>Time Slot</th><th>Action</th></tr></thead>
                <tbody>
                    @if (ViewBag.PendingList != null && ((IEnumerable<RefineryBooking.Models.Booking>)ViewBag.PendingList).Any())
                    {
                        foreach (var item in (IEnumerable<RefineryBooking.Models.Booking>)ViewBag.PendingList)
                        {
                            <tr>
                                <td class="fw-bold">@item.MeetingTitle</td>
                                <td>@item.User?.FullName <span class="badge bg-light text-dark border">@item.Department</span></td>
                                <td><span class="badge bg-secondary">@item.ConferenceRoom?.Name</span></td>
                                <td class="small fw-semibold">@item.StartTime.ToString("MMM dd, HH:mm") - @item.EndTime.ToString("HH:mm")</td>
                                <td><a asp-controller="Allocator" asp-action="Index" class="btn btn-sm btn-warning text-dark fw-bold">Review</a></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="text-center py-4 text-muted">No pending bookings in the queue! All requests have been processed.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- ================= 3. ITFM / FACILITIES DASHBOARD ================= -->
@if (isItfm)
{
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card bg-info bg-opacity-10 border-info p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-muted fw-bold mb-1">Pending AV/IT Setups</h6>
                        <h2 class="fw-bold mb-0 text-dark">@ViewBag.PendingTechCount Rooms</h2>
                    </div>
                    <a asp-controller="ITFM" asp-action="Index" class="btn btn-info text-white fw-bold">Facilities Desk <i class="fa-solid fa-arrow-right ms-1"></i></a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-warning bg-opacity-10 border-warning p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-muted fw-bold mb-1">Today's Catering Orders</h6>
                        <h2 class="fw-bold mb-0 text-dark">@ViewBag.TodayCateringCount Meetings</h2>
                    </div>
                    <a asp-controller="ITFM" asp-action="Index" class="btn btn-outline-dark fw-bold">Check Orders <i class="fa-solid fa-mug-hot ms-1"></i></a>
                </div>
            </div>
        </div>
    </div>
}

<!-- ================= 4. GENERAL USER DASHBOARD ================= -->
@if (isGeneralUser)
{
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card bg-success bg-opacity-10 border-success p-3 shadow-sm">
                <h6 class="text-uppercase text-muted fw-bold mb-1">Your Confirmed Meetings</h6>
                <h2 class="fw-bold mb-0 text-dark">@ViewBag.MyApprovedCount Approved</h2>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-warning bg-opacity-10 border-warning p-3 shadow-sm">
                <h6 class="text-uppercase text-muted fw-bold mb-1">Awaiting Allocator Review</h6>
                <h2 class="fw-bold mb-0 text-dark">@ViewBag.MyPendingCount Pending</h2>
            </div>
        </div>
    </div>
}

<!-- ================= UNIVERSAL SCHEDULE TABLE (Shows for Everyone) ================= -->
<div class="card card-industrial shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold" style="color: var(--refinery-navy);"><i class="fa-solid fa-calendar-check text-success me-2"></i> Your Immediate Upcoming Schedule</h5>
        <a asp-controller="Booking" asp-action="Index" class="btn btn-sm btn-outline-secondary">View All My History</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Meeting Title</th><th>Conference Room</th><th>Time Slot</th><th>Attendees</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-calendar-day fa-2x mb-3 d-block text-secondary"></i>
                                You have no upcoming bookings scheduled for the remainder of the week.<br />
                                Click <strong>New Room Request</strong> above to secure a conference space!
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@item.MeetingTitle</td>
                            <td><span class="badge bg-secondary"><i class="fa-solid fa-door-closed me-1"></i> @item.ConferenceRoom?.Name</span></td>
                            <td>
                                <div class="fw-semibold">@item.StartTime.ToString("MMM dd, yyyy")</div>
                                <div class="text-muted small">@item.StartTime.ToString("HH:mm") - @item.EndTime.ToString("HH:mm")</div>
                            </td>
                            <td>@item.ExpectedAttendees people</td>
                            <td>
                                @switch (item.Status)
                                {
                                    case RefineryBooking.Models.BookingStatus.Approved:
                                        <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> Approved</span>
                                        break;
                                    case RefineryBooking.Models.BookingStatus.Pending:
                                        <span class="badge bg-warning text-dark"><i class="fa-solid fa-hourglass-half me-1"></i> Pending Review</span>
                                        break;
                                    case RefineryBooking.Models.BookingStatus.Rejected:
                                        <span class="badge bg-danger" title="Reason: @item.RejectionReason"><i class="fa-solid fa-xmark me-1"></i> Rejected</span>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>