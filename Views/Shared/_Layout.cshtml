<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="NRL Conference Hall Booking System â€” Internal Resource Management" />
    <title>@ViewData["Title"] â€” Conference Hall Booking System</title>
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/nrl-og-logo.png" />
    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <!-- FullCalendar -->
    <link rel="stylesheet" href="~/lib/fullcalendar/main.min.css" />
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <!-- EXACT REPLICA NRL HEADER -->
    <header class="nrl-header-exact">
        <div class="header-wrapper">
            <!-- Left Logo Area with Slant -->
            <div class="header-left-logo">
                <a asp-controller="Home" asp-action="Index" class="logo-content">
                    <div class="logo-text-block">
                        <div class="logo-title">CONFERENCE HALL<br/>BOOKING SYSTEM</div>
                        <div class="logo-gov">NRL INTERNAL SYSTEM</div>
                    </div>
                    <div class="logo-divider"></div>
                    <img src="~/images/nrl-og-logo.png" class="logo-img" alt="NRL Logo">
                </a>
            </div>
            
            <!-- Right Content Area -->
            <div class="header-right-content">
                <!-- Top Utility Bar (Navy) -->
                <div class="header-utility">
                    <div class="utility-left">
                        <span></span>
                    </div>
                    <div class="utility-right">
                        <a href="#main-content" style="color: inherit; text-decoration: none;">Skip to main content</a>
                        <span>|</span>
                        <a href="#" onclick="adjustFontSize(1); return false;" style="color: inherit; text-decoration: none; margin: 0 2px;" title="Increase Font Size">A+</a>
                        <a href="#" onclick="adjustFontSize(0); return false;" style="color: inherit; text-decoration: none; margin: 0 2px;" title="Normal Font Size">A</a>
                        <a href="#" onclick="adjustFontSize(-1); return false;" style="color: inherit; text-decoration: none; margin: 0 2px;" title="Decrease Font Size">A-</a>
                        <span>|</span>
                        <a href="#" style="color: inherit; text-decoration: none;" title="Accessibility"><i class="fa-solid fa-wheelchair"></i></a>
                        <span>|</span>
                        <a href="#" onclick="setTheme('light'); return false;" style="color: inherit; text-decoration: none;" title="Default Theme"><i class="fa-solid fa-circle-half-stroke"></i></a>
                        <a href="#" onclick="setTheme('yellow'); return false;" style="color: yellow; text-decoration: none; margin-left: 4px;" title="High Contrast Theme"><i class="fa-solid fa-circle-half-stroke"></i></a>
                        <span>|</span>
                        @if (User.Identity!.IsAuthenticated)
                        {
                            <span class="ms-2">Signed in as: @User.Identity.Name</span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 ms-2">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-logout-small">Logout</button>
                            </form>
                        }
                    </div>
                </div>
                
                <!-- Bottom Navigation Bar (White) -->
                <div class="header-nav">
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <ul class="nav-menu">
                            <li><a asp-controller="Home" asp-action="Index" class="nav-item @(ViewData["Title"]?.ToString() == "Dashboard" ? "active" : "")">HOME</a></li>
                            
                            <li class="dropdown">
                                <a href="#" class="nav-item dropdown-toggle @(ViewData["Title"]?.ToString()?.Contains("Booking") == true && ViewData["Title"]?.ToString() != "Conference Room Calendar" ? "active" : "")" data-bs-toggle="dropdown">BOOKINGS</a>
                                <ul class="dropdown-menu">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="BookingHistory">BOOKING HISTORY</a></li>
                                        <li><a class="dropdown-item" asp-controller="Booking" asp-action="Create">NEW BOOKING</a></li>
                                    }
                                    else
                                    {
                                        <li><a class="dropdown-item" asp-controller="Booking" asp-action="Create">NEW BOOKING</a></li>
                                        <li><a class="dropdown-item" asp-controller="Booking" asp-action="Index">BOOKING HISTORY</a></li>
                                    }
                                </ul>
                            </li>
                            
                            @if (User.IsInRole("Admin") || User.IsInRole("Allocator") || User.IsInRole("ITFM"))
                            {
                                <li><a asp-controller="Booking" asp-action="Calendar" class="nav-item @(ViewData["Title"]?.ToString() == "Conference Room Calendar" ? "active" : "")">ROOM CALENDAR</a></li>
                            }
                            
                            @if (User.IsInRole("Allocator") || User.IsInRole("Admin"))
                            {
                                <li><a asp-controller="Allocator" asp-action="Index" class="nav-item @(ViewData["Title"]?.ToString() == "Allocator Desk" ? "active" : "")">ALLOCATOR DESK</a></li>
                                <li><a asp-controller="HallBlock" asp-action="Index" class="nav-item @(ViewData["Title"]?.ToString() == "Hall Availability & Blocking" ? "active" : "")">HALL BLOCKING</a></li>
                            }

                            @if (User.IsInRole("ITFM") || User.IsInRole("Admin"))
                            {
                                <li><a asp-controller="ITFM" asp-action="Index" class="nav-item @(ViewData["Title"]?.ToString()?.Contains("IT") == true ? "active" : "")">IT FACILITIES</a></li>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="dropdown">
                                    <a href="#" class="nav-item dropdown-toggle" data-bs-toggle="dropdown">USER MANAGEMENT</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users">ALL USERS</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Halls">MANAGE HALLS</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="CreateUser">CREATE USER</a></li>
                                    </ul>
                                </li>
                            }
                            
                            <li><a asp-controller="Home" asp-action="Helpdesk" class="nav-item @(ViewData["Title"]?.ToString() == "Helpdesk" ? "active" : "")">HELPDESK</a></li>
                        </ul>
                    }
                </div>
            </div>
        </div>
        <!-- Orange Bottom Line -->
        <div class="header-bottom-line"></div>
    </header>

    <!-- Main Content Container -->
    <div class="container-fluid px-4 mb-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert" style="border-radius: 2px; border-left: 4px solid #1a6e3a;">
                <i class="fa-solid fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert" style="border-radius: 2px; border-left: 4px solid #9c1a1a;">
                <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main" id="main-content">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="site-footer">
        <img src="~/images/nrl-og-logo.png" alt="NRL Logo" style="height: 14px; background: white; padding: 2px; border-radius: 2px; margin-right: 5px;" />
        Conference Hall Booking System &nbsp;|&nbsp; Numaligarh Refinery Limited &nbsp;|&nbsp; For Internal Use Only
        &nbsp;&nbsp;|&nbsp;&nbsp; &copy; @DateTime.Now.Year
    </footer>

    <!-- JS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/fullcalendar/main.min.js"></script>
    <script>
        // Accessibility Functions
        function adjustFontSize(step) {
            let htmlElement = document.documentElement;
            let currentSize = parseFloat(window.getComputedStyle(htmlElement, null).getPropertyValue('font-size'));
            if (step === 0) {
                htmlElement.style.fontSize = ''; 
            } else {
                htmlElement.style.fontSize = (currentSize + step) + 'px';
            }
        }

        function setTheme(theme) {
            let body = document.body;
            body.classList.remove('theme-yellow', 'theme-dark');
            if (theme !== 'light') {
                body.classList.add('theme-' + theme);
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
