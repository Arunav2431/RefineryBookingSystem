@model RefineryBooking.Models.Booking
@{
    ViewData["Title"] = "Request Room Booking";
}

<div class="row justify-content-center">
    <div class="col-lg-9">

        <!-- BOOKING REF BANNER -->
        <div class="alert d-flex align-items-center gap-3 mb-4 py-3 px-4" style="background:linear-gradient(90deg,#1a2a4a,#0d3b7a);border-radius:12px;color:#fff;">
            <i class="fa-solid fa-hashtag fa-lg text-warning"></i>
            <div>
                <span class="fw-bold fs-6">Booking Reference</span><br />
                <span class="text-warning fw-bold">BKG-AUTO</span>
                <span class="text-white-50 small ms-2">â€” will be assigned automatically upon submission</span>
            </div>
        </div>

        <div class="card card-industrial">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold" style="color: var(--refinery-navy);">
                    <i class="fa-solid fa-calendar-plus text-warning me-2"></i> Request Conference Room
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="bookingForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- REAL-TIME CONFLICT ALERTS -->
                    <div id="conflictAlert" class="alert alert-danger d-none" role="alert">
                        <i class="fa-solid fa-triangle-exclamation fa-lg me-2"></i>
                        <strong id="conflictMessage"></strong>
                    </div>
                    <div id="availableAlert" class="alert alert-success d-none" role="alert">
                        <i class="fa-solid fa-check-circle fa-lg me-2"></i>
                        <strong>Room is available for this time slot!</strong>
                    </div>

                    <!-- ===== SECTION 1: MEETING INFO ===== -->
                    <h6 class="fw-bold mb-3 text-uppercase small letter-spacing-1" style="color:var(--refinery-navy);">
                        <i class="fa-solid fa-circle-info me-2 text-warning"></i>Meeting Information
                    </h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-8">
                            <label asp-for="MeetingTitle" class="form-label fw-semibold">Purpose / Meeting Title *</label>
                            <input asp-for="MeetingTitle" class="form-control" placeholder="e.g., Q3 Pipeline Safety Audit Review" required />
                            <span asp-validation-for="MeetingTitle" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ExpectedAttendees" class="form-label fw-semibold">No. of Participants *</label>
                            <input asp-for="ExpectedAttendees" type="number" min="1" max="500" class="form-control" value="5" required />
                            <span asp-validation-for="ExpectedAttendees" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="OrganizerName" class="form-label fw-semibold">Organizer Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-user text-secondary"></i></span>
                                <input asp-for="OrganizerName" class="form-control" readonly style="background:#f8f9fa;" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label fw-semibold">Department</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-building text-secondary"></i></span>
                                <input asp-for="Department" class="form-control" readonly style="background:#f8f9fa;" />
                            </div>
                        </div>
                    </div>

                    <hr class="my-3" />

                    <!-- ===== SECTION 2: ROOM & SCHEDULE ===== -->
                    <h6 class="fw-bold mb-3 text-uppercase small" style="color:var(--refinery-navy);">
                        <i class="fa-solid fa-door-open me-2 text-warning"></i>Hall & Schedule
                    </h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="ConferenceRoomId" class="form-label fw-semibold">Hall Selection *</label>
                            <select asp-for="ConferenceRoomId" class="form-select searchable-select" asp-items="ViewBag.Rooms" id="roomSelect" required style="width: 100%;">
                                <option value="">-- Select Conference Hall --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CostCentre" class="form-label fw-semibold">Cost Centre *</label>
                            <select asp-for="CostCentre" class="form-select searchable-select" asp-items="ViewBag.CostCentres" id="costCentreSelect" required style="width: 100%;">
                                <option value="">-- Select Cost Centre --</option>
                            </select>
                            <span asp-validation-for="CostCentre" class="text-danger small"></span>
                        </div>
                        <!-- Single shared date picker -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">Booking Date *</label>
                            <input type="date" id="bookingDate" class="form-control"
                                   min="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>

                        <!-- Hidden fields for model binding -->
                        <input type="hidden" asp-for="StartTime" id="startTime" />
                        <input type="hidden" asp-for="EndTime"   id="endTime" />

                        <!-- Start Time -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                <i class="fa-regular fa-clock me-1 text-warning"></i>Start Time *
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-hourglass-start text-secondary"></i></span>
                                <select id="startHour" class="form-select" style="max-width:80px;">
                                    <option value="1">01</option>
                                    <option value="2">02</option>
                                    <option value="3">03</option>
                                    <option value="4">04</option>
                                    <option value="5">05</option>
                                    <option value="6">06</option>
                                    <option value="7">07</option>
                                    <option value="8">08</option>
                                    <option value="9" selected>09</option>
                                    <option value="10">10</option>
                                    <option value="11">11</option>
                                    <option value="12">12</option>
                                </select>
                                <span class="input-group-text px-1 fw-bold">:</span>
                                <select id="startMin" class="form-select" style="max-width:80px;">
                                    <option value="00">00</option>
                                    <option value="15">15</option>
                                    <option value="30" selected>30</option>
                                    <option value="45">45</option>
                                </select>
                                <select id="startAmPm" class="form-select" style="max-width:85px;">
                                    <option value="AM">AM</option>
                                    <option value="PM">PM</option>
                                </select>
                            </div>
                            <span asp-validation-for="StartTime" class="text-danger small"></span>
                        </div>

                        <!-- End Time -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                <i class="fa-regular fa-clock me-1 text-warning"></i>End Time *
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-hourglass-end text-secondary"></i></span>
                                <select id="endHour" class="form-select" style="max-width:80px;">
                                    <option value="1">01</option>
                                    <option value="2">02</option>
                                    <option value="3">03</option>
                                    <option value="4">04</option>
                                    <option value="5" selected>05</option>
                                    <option value="6">06</option>
                                    <option value="7">07</option>
                                    <option value="8">08</option>
                                    <option value="9">09</option>
                                    <option value="10">10</option>
                                    <option value="11">11</option>
                                    <option value="12">12</option>
                                </select>
                                <span class="input-group-text px-1 fw-bold">:</span>
                                <select id="endMin" class="form-select" style="max-width:80px;">
                                    <option value="00">00</option>
                                    <option value="15">15</option>
                                    <option value="30">30</option>
                                    <option value="45">45</option>
                                </select>
                                <select id="endAmPm" class="form-select" style="max-width:85px;">
                                    <option value="AM">AM</option>
                                    <option value="PM" selected>PM</option>
                                </select>
                            </div>
                            <span asp-validation-for="EndTime" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <div class="alert alert-info py-2 mb-0 d-flex align-items-center gap-2">
                                <i class="fa-solid fa-clock text-info"></i>
                                <span class="small"><strong>Working Hours:</strong> Bookings are only permitted between <strong>09:30 &ndash; 17:30</strong>.</span>
                                <span id="slotStatus" class="ms-auto badge bg-secondary">Select times to check</span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-3" />

                    <!-- ===== SECTION 3: EQUIPMENT ===== -->
                    <h6 class="fw-bold mb-3 text-uppercase small" style="color:var(--refinery-navy);">
                        <i class="fa-solid fa-plug me-2 text-warning"></i>Equipment Required
                    </h6>
                    <div class="row g-3 mb-4 bg-light p-3 rounded mx-0">
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="itReq.NeedsVideoConferencing" value="true" id="vcCheck">
                                <label class="form-check-label" for="vcCheck"><i class="fa-solid fa-video me-1 text-info"></i> Video Conferencing</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="itReq.NeedsProjector" value="true" id="projCheck">
                                <label class="form-check-label" for="projCheck"><i class="fa-solid fa-projector me-1 text-primary"></i> Overhead Projector</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="itReq.NeedsWhiteboard" value="true" id="wbCheck">
                                <label class="form-check-label" for="wbCheck"><i class="fa-solid fa-chalkboard me-1 text-success"></i> Whiteboard</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="itReq.NeedsPASystem" value="true" id="paCheck">
                                <label class="form-check-label" for="paCheck"><i class="fa-solid fa-tower-broadcast me-1 text-danger"></i> PA System</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="itReq.NeedsLaptop" value="true" id="lapCheck">
                                <label class="form-check-label" for="lapCheck"><i class="fa-solid fa-laptop me-1 text-secondary"></i> Laptop</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="itReq.NeedsLaserPointer" value="true" id="lpCheck">
                                <label class="form-check-label" for="lpCheck"><i class="fa-solid fa-computer-mouse me-1 text-warning"></i> Laser Pointer</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="RequiresCatering" id="catCheck">
                                <label class="form-check-label" for="catCheck"><i class="fa-solid fa-mug-hot me-1 text-warning"></i> Refreshments / Tea</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Microphone Count</label>
                            <input type="number" name="itReq.MicCount" class="form-control form-control-sm" value="0" min="0" max="20" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Other / Special Instructions for AV Team</label>
                            <input type="text" name="itReq.TechNotes" class="form-control form-control-sm" placeholder="e.g., Need HDMI adapters, guest Wi-Fi vouchers, stage lighting" />
                        </div>
                    </div>

                    <hr class="my-3" />

                    <!-- ===== SECTION 4: ADDITIONAL DETAILS ===== -->
                    <h6 class="fw-bold mb-3 text-uppercase small" style="color:var(--refinery-navy);">
                        <i class="fa-solid fa-file-lines me-2 text-warning"></i>Additional Details
                    </h6>
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <label asp-for="Remarks" class="form-label fw-semibold">Remarks / Notes</label>
                            <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Any special arrangements, access requirements, or notes for the Allocator..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Attachment <span class="text-muted small fw-normal">(PDF, Word, Excel, Images â€” max 5 MB)</span></label>
                            <input type="file" name="attachment" class="form-control" accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg" id="attachmentInput" />
                            <div id="filePreview" class="mt-2 text-muted small d-none">
                                <i class="fa-solid fa-paperclip me-1"></i><span id="fileName"></span>
                            </div>
                        </div>
                    </div>

                    <!-- ===== SECTION 5: HELP REQUIRED (Optional) ===== -->
                    <hr class="my-4" />
                    <h6 class="fw-bold mb-3 text-uppercase small" style="color:var(--nrl-navy);">
                        <i class="fa-solid fa-hands-helping me-2"></i>Support Required <span class="text-muted fw-normal normal-case small ms-1">(Optional)</span>
                    </h6>
                    <p class="text-muted small mb-3">If you need assistance from either the IT/Facilities team or the Allocator, indicate it here so they are notified.</p>

                    <div class="row g-3 mb-4">
                        <!-- ITFM Help -->
                        <div class="col-md-6">
                            <div class="card border" style="border-radius:2px;">
                                <div class="card-body py-3 px-3">
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="chkITFM"
                                               name="RequiresITFMHelp" value="true"
                                               onchange="toggleHelp('itfmHelp', this.checked)" />
                                        <label class="form-check-label fw-bold" for="chkITFM">
                                            <i class="fa-solid fa-toolbox me-1" style="color:var(--nrl-navy);"></i>
                                            Request IT/Facilities Help
                                        </label>
                                    </div>
                                    <p class="text-muted small mb-2">AV setup, projector, microphones, VC, PA system, etc.</p>
                                    <div id="itfmHelp" class="d-none">
                                        <textarea name="ITFMHelpDetails" class="form-control form-control-sm" rows="2"
                                                  placeholder="Describe what you need, e.g., 'VC setup with 2 mics, whiteboard markers'"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Allocator Help -->
                        <div class="col-md-6">
                            <div class="card border" style="border-radius:2px;">
                                <div class="card-body py-3 px-3">
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="chkAllocator"
                                               name="RequiresAllocatorHelp" value="true"
                                               onchange="toggleHelp('allocatorHelp', this.checked)" />
                                        <label class="form-check-label fw-bold" for="chkAllocator">
                                            <i class="fa-solid fa-clipboard-check me-1" style="color:var(--nrl-navy);"></i>
                                            Request Allocator Assistance
                                        </label>
                                    </div>
                                    <p class="text-muted small mb-2">Room query, schedule conflict, special arrangement, etc.</p>
                                    <div id="allocatorHelp" class="d-none">
                                        <textarea name="AllocatorHelpDetails" class="form-control form-control-sm" rows="2"
                                                  placeholder="Describe what you need, e.g., 'Flexible on timing, need largest available room'"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ACTIONS -->
                    <div class="d-flex justify-content-end gap-2 mt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-arrow-left me-1"></i> Cancel
                        </a>
                        <button type="button" id="btnCheckConflict" class="btn btn-info text-white fw-bold">
                            <i class="fa-solid fa-rotate me-1"></i> Verify Availability
                        </button>
                        <button type="submit" id="btnSubmit" class="btn btn-amber px-4">
                            <i class="fa-solid fa-paper-plane me-1"></i> Submit Request
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            // File name preview
            $('#attachmentInput').on('change', function () {
                var file = this.files[0];
                if (file) {
                    $('#fileName').text(file.name);
                    $('#filePreview').removeClass('d-none');
                } else {
                    $('#filePreview').addClass('d-none');
                }
            });

            // Convert 12-hour select values to decimal 24-hour float (e.g. 4 PM + 15 min = 16.25)
            function selectsToDecimalH(hourId, minId, ampmId) {
                var h  = parseInt($('#' + hourId).val(), 10);
                var m  = parseInt($('#' + minId).val(), 10);
                var ap = $('#' + ampmId).val();
                if (ap === 'PM' && h !== 12) h += 12;
                if (ap === 'AM' && h === 12) h = 0;
                return h + m / 60;
            }

            // Build "YYYY-MM-DDTHH:mm" from a date input + time selects, store in hidden field
            function buildHidden(dateId, hourId, minId, ampmId, hiddenId) {
                var d  = $('#' + dateId).val();
                if (!d) return;
                var h  = parseInt($('#' + hourId).val(), 10);
                var m  = $('#' + minId).val();
                var ap = $('#' + ampmId).val();
                if (ap === 'PM' && h !== 12) h += 12;
                if (ap === 'AM' && h === 12) h = 0;
                var hStr = h.toString().padStart(2, '0');
                $('#' + hiddenId).val(d + 'T' + hStr + ':' + m);
            }

            function syncAll() {
                buildHidden('bookingDate', 'startHour', 'startMin', 'startAmPm', 'startTime');
                buildHidden('bookingDate', 'endHour',   'endMin',   'endAmPm',   'endTime');
            }

            // Working hours indicator — reads directly from selects, no Date() timezone issues
            function checkWorkingHours() {
                var d = $('#bookingDate').val();
                if (!d) return;

                var startH = selectsToDecimalH('startHour', 'startMin', 'startAmPm');
                var endH   = selectsToDecimalH('endHour',   'endMin',   'endAmPm');
                var badge  = $('#slotStatus');

                if (startH < 9.5 || endH > 17.5) {
                    badge.removeClass('bg-secondary bg-success bg-warning text-dark').addClass('bg-danger').text('Outside working hours!');
                } else if (startH >= endH) {
                    badge.removeClass('bg-secondary bg-success bg-danger').addClass('bg-warning text-dark').text('Invalid time range');
                } else {
                    badge.removeClass('bg-secondary bg-danger bg-warning text-dark').addClass('bg-success').text('Within working hours ✔');
                }
            }

            // Availability check
            var checkAvailabilityTimeout;
            var currentAvailabilityRequest = null;

            function checkAvailability() {
                clearTimeout(checkAvailabilityTimeout);
                checkAvailabilityTimeout = setTimeout(executeCheckAvailability, 300);
            }

            function executeCheckAvailability() {
                syncAll();
                checkWorkingHours();

                var roomSelectDom = document.getElementById('roomSelect');
                var roomId = roomSelectDom ? roomSelectDom.value : null;
                var start  = $('#startTime').val();
                var end    = $('#endTime').val();
                if (!roomId || !start || !end) return;

                $('#conflictAlert').addClass('d-none');
                $('#availableAlert').addClass('d-none');

                if (currentAvailabilityRequest) {
                    currentAvailabilityRequest.abort();
                }

                currentAvailabilityRequest = $.getJSON('@Url.Action("CheckAvailability", "Booking")', { roomId: roomId, start: start, end: end }, function (res) {
                    if (!res.available) {
                        $('#conflictMessage').html(res.message.replace(/\n/g, '<br/>'));
                        $('#conflictAlert').removeClass('d-none');
                        $('#btnSubmit').prop('disabled', true);
                    } else {
                        $('#availableAlert').removeClass('d-none');
                        $('#conflictAlert').addClass('d-none');
                        $('#btnSubmit').prop('disabled', false);
                    }
                });
            }

            // Refresh room dropdown when date changes to reflect hall blocks
            function refreshRoomDropdown() {
                var d = $('#bookingDate').val();
                if (!d) return;
                var rsDom = document.getElementById('roomSelect');
                var currentRoom = rsDom ? rsDom.value : null;
                $.getJSON('@Url.Action("GetAvailableRoomsForDate", "Booking")', { date: d }, function (rooms) {
                    var sel = $('#roomSelect');
                    sel.empty();
                    sel.append($('<option>').val('').text('-- Select Conference Hall --'));
                    $.each(rooms, function (i, r) {
                        var opt = $('<option>').val(r.id);
                        if (r.isBlocked) {
                            opt.text(r.name + ' \u2014 \u26d4 ' + r.blockReason);
                            opt.css('color', '#c0392b');
                        } else {
                            opt.text(r.name);
                        }
                        if (r.id == currentRoom) {
                            opt.prop('selected', true);
                        }
                        sel.append(opt);
                    });
                    checkAvailability();
                });
            }

            // Any date/time control change triggers a sync + check
            $('#bookingDate').on('change', function () {
                refreshRoomDropdown();
                checkAvailability();
            });
            $('#startHour, #startMin, #startAmPm, #endHour, #endMin, #endAmPm').on('change', checkAvailability);

            $('#roomSelect').on('change', checkAvailability);
            $('#btnCheckConflict').click(checkAvailability);

            // Initialise on page load
            syncAll();
            refreshRoomDropdown();
        });

        function toggleHelp(divId, show) {
            var el = document.getElementById(divId);
            if (show) { el.classList.remove('d-none'); }
            else       { el.classList.add('d-none'); el.querySelector('textarea').value = ''; }
        }
    </script>
}
